# Use shell colors (from fish)
set shell fish

# ui
set drawbox true
set ratios 1:1

# preview
set preview true
set previewer ~/.config/lf/preview
set dirpreviews true

# redraw behavior
set cleaner ~/.config/lf/preview

# navigation
map p :set preview!
map H :set hidden!
map <space> shell

# run "ff" in fish when ff is typed
map <tab> toggle